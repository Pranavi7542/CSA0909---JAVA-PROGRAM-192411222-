
public class Main {

    // Parent class
    static class Vehicle {
        private final String regNo;

        Vehicle(String regNo) {
            this.regNo = regNo;
        }

        public String getRegNo() {
            return regNo;
        }

        // Method to be overridden by subclasses
        public double calculateFee(int hours) {
            return 0;
        }

        // Return vehicle information
        @Override
        public String toString() {
            return "Vehicle Registration: " + regNo;
        }

        // Two vehicles are equal if their registration numbers match
        @Override
        public boolean equals(Object obj) {
            if (this == obj) {
                return true;
            }

            if (!(obj instanceof Vehicle)) {
                return false;
            }

            Vehicle other = (Vehicle) obj;
            return regNo.equals(other.regNo);
        }

        @Override
        public int hashCode() {
            return regNo.hashCode();
        }
    }

    // TwoWheeler subclass
    static class TwoWheeler extends Vehicle {

        TwoWheeler(String regNo) {
            super(regNo);
        }

        @Override
        public double calculateFee(int hours) {
            return hours * 10;
        }

        @Override
        public String toString() {
            return "TwoWheeler: " + getRegNo();
        }
    }

    // Car subclass
    static class Car extends Vehicle {

        Car(String regNo) {
            super(regNo);
        }

        @Override
        public double calculateFee(int hours) {
            return hours * 30;
        }

        @Override
        public String toString() {
            return "Car: " + getRegNo();
        }
    }

    // ElectricCar subclass
    static class ElectricCar extends Car {

        ElectricCar(String regNo) {
            super(regNo);
        }

        // Charging fee is added separately
        public double chargingFee(int units) {
            return units * 12;
        }

        @Override
        public String toString() {
            return "ElectricCar: " + getRegNo();
        }
    }

    public static void main(String[] args) {

        Vehicle bike = new TwoWheeler("TN01AB1111");
        Vehicle car = new Car("TN02CD2222");
        ElectricCar ev = new ElectricCar("TN03EF3333");

        System.out.println(bike);
        System.out.println("Parking Fee: Rs. "
                + bike.calculateFee(2));

        System.out.println("\n" + car);
        System.out.println("Parking Fee: Rs. "
                + car.calculateFee(2));

        System.out.println("\n" + ev);
        System.out.println("Parking Fee: Rs. "
                + ev.calculateFee(2));
        System.out.println("Charging Fee: Rs. "
                + ev.chargingFee(10));

        // Compare vehicles by registration number
        Car car1 = new Car("TN02CD2222");
        ElectricCar car2 = new ElectricCar("TN02CD2222");

        System.out.println("\nAre both vehicles equal? "
                + car1.equals(car2));
    }
}
