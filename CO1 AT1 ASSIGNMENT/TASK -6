
public class Main {

    // Superclass
    static class Vehicle {
        protected String regNo;
        protected double ratePerHour;

        Vehicle(String regNo, double ratePerHour) {
            this.regNo = regNo;
            this.ratePerHour = ratePerHour;

            System.out.println("Vehicle constructor called");
        }

        double calculateFee(int hours) {
            return hours * ratePerHour;
        }

        void displayDetails() {
            System.out.println("Registration Number: " + regNo);
            System.out.println("Rate per hour: Rs. " + ratePerHour);
        }
    }

    // Subclass: TwoWheeler inherits Vehicle
    static class TwoWheeler extends Vehicle {

        TwoWheeler(String regNo) {
            super(regNo, 10);
            System.out.println("TwoWheeler constructor called");
        }
    }

    // Subclass: Car inherits Vehicle
    static class Car extends Vehicle {

        Car(String regNo) {
            super(regNo, 30);
            System.out.println("Car constructor called");
        }
    }

    // ElectricCar inherits Car (multilevel inheritance)
    static class ElectricCar extends Car {

        ElectricCar(String regNo) {
            super(regNo);
            System.out.println("ElectricCar constructor called");
        }
    }

    public static void main(String[] args) {

        System.out.println("Creating TwoWheeler:");
        TwoWheeler bike = new TwoWheeler("TN01AB1111");
        bike.displayDetails();
        System.out.println("Fee for 2 hours: Rs. "
                + bike.calculateFee(2));

        System.out.println("\nCreating Car:");
        Car car = new Car("TN02CD2222");
        car.displayDetails();
        System.out.println("Fee for 2 hours: Rs. "
                + car.calculateFee(2));

        System.out.println("\nCreating ElectricCar:");
        ElectricCar ev = new ElectricCar("TN03EF3333");
        ev.displayDetails();
        System.out.println("Fee for 2 hours: Rs. "
                + ev.calculateFee(2));
    }
}
