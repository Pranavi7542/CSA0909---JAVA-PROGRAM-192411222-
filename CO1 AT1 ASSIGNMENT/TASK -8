interface Chargeable {
    double chargingFee(double kWh);
}

abstract class Vehicle {
    protected String regNo;

    Vehicle(String regNo) {
        this.regNo = regNo;
    }

    abstract double calculateFee(int minutes);

    String getRegNo() {
        return regNo;
    }
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String regNo) {
        super(regNo);
    }

    @Override
    double calculateFee(int minutes) {
        int hours = (minutes + 59) / 60;
        return hours * 15.0;
    }
}

class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }

    @Override
    double calculateFee(int minutes) {
        int hours = (minutes + 59) / 60;
        return hours * 30.0;
    }
}

class ElectricCar extends Car implements Chargeable {
    ElectricCar(String regNo) {
        super(regNo);
    }

    @Override
    public double chargingFee(double kWh) {
        return kWh * 12.0;
    }

    @Override
    double calculateFee(int minutes) {
        return super.calculateFee(minutes) + chargingFee(10.0);
    }
}

public class Main {
    public static void main(String[] args) {
        Vehicle[] vehicles = {
            new TwoWheeler("TN01A1"),
            new Car("TN02B2"),
            new ElectricCar("TN03C3")
        };

        int parkingMinutes = 120;

        for (Vehicle v : vehicles) {
            double fee = v.calculateFee(parkingMinutes);

            if (v instanceof Chargeable) {
                Chargeable c = (Chargeable) v;
                fee += c.chargingFee(0); // charging already included above
            }

            System.out.println(
                v.getClass().getSimpleName() + " "
                + v.getRegNo() + " -> Rs " + fee
            );
        }

        System.out.println(vehicles[2] instanceof Chargeable);
    }
}
