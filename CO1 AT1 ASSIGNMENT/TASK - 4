
public class Main {

    // Class representing a vehicle
    static class Vehicle {
        String regNo;
        String vehicleType;

        // Default constructor
        Vehicle() {
            this("UNKNOWN", "Car");
        }

        // Parameterized constructor
        Vehicle(String regNo, String vehicleType) {
            this.regNo = regNo;
            this.vehicleType = vehicleType;
        }

        void displayVehicle() {
            System.out.println("Registration Number: " + regNo);
            System.out.println("Vehicle Type: " + vehicleType);
        }
    }

    // Class representing a parking ticket
    static class ParkingTicket {
        static int counter = 1000;

        int ticketNo;
        Vehicle vehicle;
        int slotNo;
        int entryHour;

        // Constructor with vehicle and slot
        ParkingTicket(Vehicle vehicle, int slotNo) {
            this(vehicle, slotNo, 9);
        }

        // Overloaded parameterized constructor
        ParkingTicket(Vehicle vehicle, int slotNo, int entryHour) {
            counter++;
            this.ticketNo = counter;
            this.vehicle = vehicle;
            this.slotNo = slotNo;
            this.entryHour = entryHour;
        }

        void displayTicket() {
            System.out.println("\nTicket Number: " + ticketNo);
            vehicle.displayVehicle();
            System.out.println("Parking Slot: " + slotNo);
            System.out.println("Entry Hour: " + entryHour);
        }
    }

    public static void main(String[] args) {

        // Creating objects using constructors
        Vehicle v1 = new Vehicle("TN01AB1111", "TwoWheeler");
        Vehicle v2 = new Vehicle("TN02CD2222", "Car");
        Vehicle v3 = new Vehicle();

        // Creating parking ticket objects
        ParkingTicket t1 = new ParkingTicket(v1, 1);
        ParkingTicket t2 = new ParkingTicket(v2, 2, 10);
        ParkingTicket t3 = new ParkingTicket(v3, 3, 11);

        // Display ticket details
        t1.displayTicket();
        t2.displayTicket();
        t3.displayTicket();
    }
}
