
public class Main {

    // Parking ticket class
    static class ParkingTicket {

        // Shared by all ParkingTicket objects
        private static int ticketCounter = 1000;
        private static int totalTickets = 0;

        private final int ticketNumber;
        private final String vehicleNumber;

        // Constructor
        ParkingTicket(String vehicleNumber) {
            ticketCounter++;
            totalTickets++;

            this.ticketNumber = ticketCounter;
            this.vehicleNumber = vehicleNumber;
        }

        // Instance method: displays one ticket's details
        void displayTicket() {
            System.out.println("Ticket Number: " + ticketNumber);
            System.out.println("Vehicle Number: " + vehicleNumber);
        }

        // Static method: displays shared ticket count
        static void displayTotalTickets() {
            System.out.println("Total Tickets Created: " + totalTickets);
        }

        // Static method: generates the next ticket number
        static int getNextTicketNumber() {
            return ticketCounter + 1;
        }
    }

    public static void main(String[] args) {

        // Create ticket objects
        ParkingTicket t1 = new ParkingTicket("TN01AB1111");
        ParkingTicket t2 = new ParkingTicket("TN02CD2222");
        ParkingTicket t3 = new ParkingTicket("TN03EF3333");

        // Display ticket information
        t1.displayTicket();
        System.out.println();

        t2.displayTicket();
        System.out.println();

        t3.displayTicket();
        System.out.println();

        // Call static methods using the class name
        ParkingTicket.displayTotalTickets();

        System.out.println("Next Ticket Number: "
                + ParkingTicket.getNextTicketNumber());

        // Simulate vehicle exit: remove the reference to ticket 1
        t1 = null;

        System.out.println("\nTicket 1 reference set to null.");
        System.out.println("Ticket 1 may now be garbage collected.");
    }
}
